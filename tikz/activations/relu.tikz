\usepackage{tikz}
\usepackage{pgfplots}

\usetikzlibrary{arrows.meta}

\definecolor{pink}{RGB}{255,52,124}
\definecolor{blue}{RGB}{50,205,255}
\definecolor{green}{RGB}{67,243,150}
\definecolor{darkgrey}{RGB}{48,48,48}

\begin{document}
\begin{tikzpicture}[draw=darkgrey,x=2cm,y=2cm]
    % Axis
    \draw[->, thick, -{Stealth[round]}] (-1,0) -- (1,0) node[label={[label distance=1]135:\(z\)}] {};
    \draw[->, thick, -{Stealth[round]}] (0,-1) -- (0,1);
    \node[label={below left:\(0\)}] at (0, 0) {};
    \begin{axis}[
        hide axis=true,
        at={(0,0)},
        anchor=origin,
        xmin=-2,
        xmax=2,
        ymin=0,
        ymax=2,
        clip=false,
        x=1cm,
        y=1cm,
    ]
        \addplot[color=blue,line width=2pt,opacity=0.9] table [x=z, y=relu, col sep=comma] {tikz/activations/linearunit.csv};
    \end{axis}
\end{tikzpicture}
