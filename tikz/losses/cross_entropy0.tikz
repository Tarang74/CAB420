\begin{tikzpicture}[draw=darkgrey]
    % Axis
    \draw[->, thick, -{Stealth[round]}] (-3,0) -- (3,0) node[label={[label distance=1]135:\(z\)}] {};
    \draw[thick] (-2,-0.15) --++ (0,0.3);
    \draw[thick] (2,-0.15) --++ (0,0.3);
    \node[label=below:\(y \equal 0\)] at (-2, 0) {};
    \node[label=below:\(1\)] at (2, 0) {};
    \begin{axis}[
        axis x line=none,
        axis y line=none,
        anchor=origin,
        axis line style={draw=none},
        xtick=\empty,
        xmin=-0.6,
        xmax=0.6,
        ymin=-0.1,
        ymax=0.7,
        ytick=\empty,
        x=4cm,
