\begin{document}
\begin{tikzpicture}[draw=darkgrey,x=2cm,y=2cm]
    % Axis
    \draw[->, thick, -{Stealth[round]}] (-1.5,0) -- (1.5,0) node[label={[label distance=1]135:\(z\)}] {};
    \draw[thick] (-1,-0.08) --++ (0,0.16);
    \node[label=below:\(y \equal -1\)] at (-1, 0) {};
    \begin{axis}[
        hide axis=true,
        at={(0,0)},
        anchor=origin,
        xmin=-1.25,
        xmax=1.25,
        ymin=0,
        ymax=1,
        clip=false,
        x=2cm,
        y=2cm,
    ]
        \addplot[color=pink,line width=2pt,opacity=0.9] table [x=z, y=logistic0, col sep=comma] {tikz/losses/logistic.csv};
